@@ -74,6 +77,12 @@
 
 tasks = sorted(p.name for p in fam_root.iterdir()
                if p.is_dir() and p.name.startswith("task_"))
+wanted = __import__("os").environ.get("TASKS", "").split()
+if wanted:
+    unknown = sorted(set(wanted) - set(tasks))
+    if unknown:
+        raise SystemExit(f"TASKS names unknown task directories: {unknown}")
+    tasks = [t for t in tasks if t in wanted]
 plan = []
 for t in tasks:
     base = load(fam_root / t / "base" / "diagnostics.jsonl")
